generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Strategy {
  id              String   @id @default(cuid())
  symbol          String   @unique
  // Initial Multiplier (j)
  initialParamJ   Float
  // Step Drop Multiplier (k)
  stepParamK      Float
  maxSteps        Int
  stepAmount      Float

  // "True" if user toggled on automated execution
  autoExecute     Boolean  @default(false)

  trades          Trade[]
  orders          Order[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Trade {
  id              String   @id @default(cuid())
  strategyId      String
  strategy        Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  step            Int
  shares          Float
  buyPrice        Float
  buyDate         String   // YYYY-MM-DD
  sellPrice       Float?
  sellDate        String?  // YYYY-MM-DD

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([strategyId])
}

model Order {
  id              String   @id @default(cuid())
  strategyId      String
  strategy        Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  step            Int
  side            String   // "BUY" or "SELL"
  ibkrOrderId     Int?     // IBKR's unique order ID
  status          String   @default("pending") // pending, submitted, filled, cancelled
  limitPrice      Float
  totalQty        Float
  filledQty       Float    @default(0)
  avgFillPrice    Float?
  expiresAt       DateTime?
  filledAt        DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([strategyId])
  @@index([status])
}

model DailyCandle {
  id              String   @id @default(cuid())
  symbol          String
  date            String   // YYYY-MM-DD format
  open            Float
  high            Float
  low             Float
  close           Float
  volume          Float
  
  createdAt       DateTime @default(now())

  // Ensure we don't store duplicates for the same day and ticker
  @@unique([symbol, date])
}

// Singleton heartbeat — upserted by the trading engine every ~60s
model EngineHeartbeat {
  id        String   @id @default("singleton")
  timestamp DateTime @updatedAt
}

// Cached calculation results — invalidated when the lastDate changes
model SymbolCache {
  id              String   @id @default(cuid())
  symbol          String   @unique
  lastDate        String   // YYYY-MM-DD of the most recent candle used
  sma200          Float
  dailyVolatility Float
  latestPrice     Float

  updatedAt       DateTime @updatedAt
}
